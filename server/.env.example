# Copy this file to .env and fill it in. Never commit .env.

# Django
SECRET_KEY=change-me
# Exactly "True" turns debug mode on - anything else means off
DEBUG=True

# Database
# Leave DATABASE_URL commented out to use a local SQLite file (db.sqlite3)
# Set it only to work on the shared Neon database, which the production app uses.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Open Food Facts identification
OPEN_FOOD_FACTS_USER_AGENT=CommonPantry/0.1

# EMAIL CONFIG
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-adress@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-adress@gmail.com