[run]
source = api
omit =
    *migrations*
    *management*
    *tests*
    *config*
    manage.py
    *asgi.py
    *wsgi.py

[report]
omit =
    *migrations*
    *management*
    *tests*
    *config*
    manage.py
    *asgi.py
    *wsgi.py
exclude_lines =
    pragma: no cover
    def __str__
    def __repr__